@using Microsoft.AspNetCore.Components.Authorization
@inject INodeClientProvider NodeProvider
@inject IJSRuntime JS

<header class="topbar">
    <div class="topbar-left">
        <h1 class="topbar-title">@GetPageTitle()</h1>
    </div>
    <div class="topbar-right">
        @if (NodeProvider.Topology is { } topo)
        {
            <div class="topbar-cluster">
                <TsakIcon Name="cluster" Size="14" />
                <span>@topo.ClusterName</span>
                <TsakBadge Text="@($"{topo.Nodes.Count(n => n.IsAlive)} / {topo.Nodes.Count}")" Variant="online" />
            </div>
        }
        <button class="btn btn-icon btn-ghost" @onclick="ToggleTheme" title="Toggle theme">
            <TsakIcon Name="@_themeIcon" Size="18" />
        </button>
        <span class="text-sm text-secondary">@_displayName</span>
        <TsakBadge Text="@(_role ?? "—")" Variant="@(_isAdmin ? "online" : "info")" ShowDot="false" />
        <form method="post" action="auth/logout" class="topbar-logout-form">
            <AntiforgeryToken />
            <button type="submit" class="btn btn-ghost btn-sm">
                <TsakIcon Name="logout" Size="16" />
                <span>Logout</span>
            </button>
        </form>
    </div>
</header>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private string _themeIcon = "sun";
    private string? _displayName;
    private string? _role;
    private bool _isAdmin;

    protected override async Task OnParametersSetAsync()
    {
        if (AuthState is null) return;
        var user = (await AuthState).User;
        _displayName = user.FindFirst("display_name")?.Value ?? user.Identity?.Name;
        _role = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
        _isAdmin = user.IsInRole("admin");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var theme = await JS.InvokeAsync<string>("tsakTheme.get");
            _themeIcon = theme == "dark" ? "sun" : "moon";
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        var newTheme = await JS.InvokeAsync<string>("tsakTheme.toggle");
        _themeIcon = newTheme == "dark" ? "sun" : "moon";
    }

    private string GetPageTitle()
    {
        // Simple page title from URL
        return "Dashboard";
    }
}
