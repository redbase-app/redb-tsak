@inherits LayoutComponentBase
@inject ToastService Toast
@implements IDisposable

@* Anonymous access is blocked by the [Authorize] attribute every page inherits from
   _Imports.razor (AuthorizeRouteView enforces the PAGE's own authorize metadata and redirects to
   /login), so the shell only ever renders for an authenticated principal from the auth cookie. *@
<div class="shell">
    <TsakSidebar />
    <div class="shell-main">
        <TsakTopBar />
        <main class="shell-content">
            <TsakErrorBoundary>
                @Body
            </TsakErrorBoundary>
        </main>
    </div>
</div>
<TsakToast @ref="_toast" />

@code {
    private TsakToast? _toast;

    protected override void OnInitialized()
    {
        Toast.OnShow += OnToast;
    }

    private void OnToast(string message, string level, int durationMs)
    {
        _toast?.Show(message, level, durationMs);
    }

    public void Dispose()
    {
        Toast.OnShow -= OnToast;
    }
}
