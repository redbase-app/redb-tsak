@inherits LayoutComponentBase
@inject IAuthService Auth
@inject ToastService Toast
@implements IDisposable

@if (!Auth.IsAuthenticated)
{
    <redb.Tsak.Web.Components.Pages.Login />
}
else
{
    <div class="shell">
        <TsakSidebar />
        <div class="shell-main">
            <TsakTopBar />
            <main class="shell-content">
                <TsakErrorBoundary>
                    @Body
                </TsakErrorBoundary>
            </main>
        </div>
    </div>
    <TsakToast @ref="_toast" />
}

@code {
    private TsakToast? _toast;

    protected override void OnInitialized()
    {
        Auth.OnAuthStateChanged += OnAuthChanged;
        Toast.OnShow += OnToast;
    }

    private void OnToast(string message, string level, int durationMs)
    {
        _toast?.Show(message, level, durationMs);
    }

    private void OnAuthChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Auth.OnAuthStateChanged -= OnAuthChanged;
        Toast.OnShow -= OnToast;
    }
}
