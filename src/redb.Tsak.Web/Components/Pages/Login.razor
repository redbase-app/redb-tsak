@page "/login"
@layout BlankLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<div class="login-backdrop">
    <div class="login-card">
        <div class="login-brand">
            <TsakIcon Name="database" Size="28" />
            <span class="login-brand-name">redb.Tsak</span>
        </div>

        <h2 class="login-title">Sign In</h2>
        <p class="login-subtitle">Cluster dashboard</p>

        @if (Error is not null)
        {
            <div class="login-error">
                <TsakIcon Name="alert-circle" Size="16" />
                <span>@ErrorMessage</span>
            </div>
        }

        @* Native full-page POST — an interactive circuit cannot call SignInAsync (the response has
           already started), so login goes through the /auth/login endpoint which sets the cookie and
           redirects. data-enhance=false keeps Blazor from intercepting the submit. *@
        <form method="post" action="auth/login" data-enhance="false">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />

            <div class="float-field">
                <input id="login" name="login" type="text" placeholder=" " autocomplete="username" required />
                <label for="login">Login</label>
            </div>

            <div class="float-field">
                <input id="password" name="password" type="password" placeholder=" "
                       autocomplete="current-password" required />
                <label for="password">Password</label>
            </div>

            <div class="login-actions">
                <button type="submit" class="btn btn-primary login-btn">
                    <TsakIcon Name="key" Size="16" />
                    <span>Sign In</span>
                </button>
            </div>
        </form>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] private string? Error { get; set; }
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    private string ErrorMessage => Error switch
    {
        "locked" => "Too many failed attempts. Try again later.",
        _ => "Invalid login or password."
    };
}
