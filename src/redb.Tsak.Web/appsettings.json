    "Web": {
      "AdminLogin": "admin",
      "AdminPassword": "admin",

      // === STANDALONE ===
      // "Mode": "standalone",
      // "Nodes": [
      //   { "Id": "local", "Url": "http://localhost:9090", "ApiKey": "<DEV_SECRET_PLACEHOLDER>" }
      // ]

      // === CLUSTER (active) ===
      "Mode": "cluster",
      "ServiceApiKey": "<DEV_SECRET_PLACEHOLDER>"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "redb.Tsak.Web": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss.fff} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/web-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  }
}

