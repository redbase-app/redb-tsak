<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Один TFM: это хост-приложение, а не библиотека. Directory.Build.props мультитаргетный ради пакетов. -->
    <!-- Directory.Build.props declares TargetFrameworks (plural) for the LIBRARIES. When both are
         set MSBuild takes the plural one, so a bare <TargetFramework> here is silently ignored and
         this project multi-targets anyway. Clearing it is what actually pins the single TFM. -->
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>redb.Tsak.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="Serilog.Enrichers.Process" />
    <PackageReference Include="Serilog.Enrichers.Thread" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\redb.Tsak.Client\redb.Tsak.Client.csproj" />
    <ProjectReference Include="..\redb.Tsak.Contracts\redb.Tsak.Contracts.csproj" />
    <PackageReference Include="redb.Tsak.Web.Pro" />
  </ItemGroup>

</Project>

