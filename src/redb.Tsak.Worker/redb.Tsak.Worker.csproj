<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <!-- Один TFM: это хост-приложение, а не библиотека. Directory.Build.props мультитаргетный ради пакетов. -->
    <!-- Directory.Build.props declares TargetFrameworks (plural) for the LIBRARIES. When both are
         set MSBuild takes the plural one, so a bare <TargetFramework> here is silently ignored and
         this project multi-targets anyway. Clearing it is what actually pins the single TFM. -->
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>net10.0</TargetFramework>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.2" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Enrichers.Process" Version="3.0.0" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />

    <!--
      Pin Microsoft.IdentityModel.* to 8.4.0 so the host ALC ships the same major version
      that loaded module .tpkg packages (e.g. redb.Identity.Core.Module → OpenIddict 6.3.0)
      were compiled against. Without these pins the host transitively brings in a mix of
      6.35.0 (Protocols/OpenIdConnect) and 8.0.0 (Tokens), and Default-ALC standard probing
      finds those copies in the host bin BEFORE LoadedAssemblyTracker's Resolving handler
      fires for the .tpkg's bundled 8.4.0 DLLs — yielding MissingMethodException at runtime
      (e.g. OpenIddictServerOptions.get_SigningCredentials returns List<MIT 8.4 type> but
      the loaded MIT is 8.0).
    -->
    <PackageReference Include="Microsoft.IdentityModel.Abstractions" Version="8.4.0" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.4.0" />
    <PackageReference Include="Microsoft.IdentityModel.Logging" Version="8.4.0" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols" Version="8.4.0" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.4.0" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.4.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\redb.Tsak.Core\redb.Tsak.Core.csproj" />
    <PackageReference Include="redb.Tsak.Core.Pro" Version="3.7.2" />    <!-- Connector transports moved to Libs/shared/ — loaded at runtime by SharedAssemblyLoader.
         Use scripts/build-shared.ps1 to build and copy connectors. -->
  </ItemGroup>

  <!-- Libs/ holds DEV-only runtime artifacts: hot-reloaded module packages (*.tpkg) and
       their context.json (deploy-specific, e.g. identity-pg/mssql named instances). These
       must NEVER ship in the distributable — the SDK auto-includes context.json via the
       default content glob, which baked it into the published image. Strip everything the
       SDK pulled from Libs/, then re-add ONLY Libs/shared/ below. -->
  <ItemGroup>
    <Content Remove="Libs\**" />
    <None Remove="Libs\**" />
  </ItemGroup>

  <!-- modules/ is the DEV drop dir: hot-reloaded *.tpkg packages and their context.json.
       EXACTLY the same trap as Libs/ above, hit again on 3.6.0 — the default SDK content glob
       baked worker/modules/context.json into both the image and the archive. That file was a
       developer's local redb.Identity config: Password=1 connection strings and two e2e client
       secrets, in a redb.Tsak distribution where Identity config has no business being.
       The distributable ships this directory EMPTY — the Dockerfile creates it, and
       build-archives.ps1 adds a README explaining what the operator puts there. -->
  <ItemGroup>
    <Content Remove="modules\**" />
    <None Remove="modules\**" />
  </ItemGroup>
  <!-- Only Libs/shared/ (shared connector DLLs, built by scripts/build-shared.ps1) is packaged. -->
  <ItemGroup>
    <None Include="Libs\shared\**" CopyToOutputDirectory="PreserveNewest" LinkBase="Libs\shared" />
  </ItemGroup>

  <!--
    Stage B2 of the shared-layer move (docs/SHARED_RUNTIME_PLAN.md): ALL redb.* runtime DLLs — the
    framework/providers AND every redb.Route.* that leaks in transitively (connectors, controllers,
    the redb.Route umbrella) — are PRUNED from the Worker output ROOT and served instead from
    Libs/shared. The framework is byte-loaded early by SharedRuntime; anything else redb.* is resolved
    on demand by the shared-layer resolver (installed at the same early point). So they become
    swappable patch DLLs without rebuilding this host.

    Kept in the bin: redb.Tsak.* (the host kernel) and redb.Licensing (tiny, stable, resolves from
    app-base for shared-loaded redb.* that need it). Glob-based so no per-name list drifts. Only the
    ROOT output is pruned — Libs/shared/ copies are untouched. MSBuild ExcludeAssets/PrivateAssets
    can't do this cleanly (see redb.Tsak.Core.csproj), hence an explicit post-build/publish prune.
  -->
  <Target Name="PruneRedbFromBuild" AfterTargets="Build">
    <ItemGroup>
      <_RedbToPrune Include="$(OutDir)redb.*.dll;$(OutDir)redb.*.pdb"
                    Exclude="$(OutDir)redb.Tsak.*;$(OutDir)redb.Licensing.*" />
    </ItemGroup>
    <Delete Files="@(_RedbToPrune)" />
  </Target>
  <Target Name="PruneRedbFromPublish" AfterTargets="Publish">
    <ItemGroup>
      <_RedbToPrunePub Include="$(PublishDir)redb.*.dll;$(PublishDir)redb.*.pdb"
                       Exclude="$(PublishDir)redb.Tsak.*;$(PublishDir)redb.Licensing.*" />
    </ItemGroup>
    <Delete Files="@(_RedbToPrunePub)" />
  </Target>

</Project>

