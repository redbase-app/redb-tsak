{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Username=postgres;Password=<PASSWORD>;Database=redb;Pooling=true;Include Error Detail=true",
    "MSSql": "Server=msdb;Database=redb;User Id=sa;Password=<PASSWORD>;TrustServerCertificate=true;Command Timeout=600;",
    "Sqlite": "Data Source=C:/Work/redb_code/csharp/redb/redb.Tsak/redb.db"
  },
  "Tsak": {
    "Storage": {
      "Type": "Redb"
    },
    "Redb": {
      "//Provider": "postgres | mssql | sqlite — Sqlite uses ConnectionStrings:Sqlite (Data Source=…db)",
      "Provider": "sqlite",
      "UsePro": true,
      "License": [""],
      "PropsSaveStrategy": "DeleteInsert",
      "//Cache": "redb cache tuning. Values below are redb's own defaults — an absent section changes nothing.",
      "Cache": {
        "EnableProps": false,
        "PropsMaxSize": 10000,
        "PropsTtlMinutes": 60,
        "//SkipHashValidationOnCacheCheck": "true = trust cache without re-checking the object hash in DB (faster, single-writer only). MUST be false in a cluster — can serve stale data.",
        "SkipHashValidationOnCacheCheck": false,
        "EnableList": true,
        "ListTtlMinutes": 5,
        "EnableMetadata": true,
        "MetadataTtlMinutes": 30,
        "AutoRecomputeHash": true,
        "//CacheDomain": "isolate scheme caches between databases; empty = derived from the connection string hash",
        "CacheDomain": ""
      }
    },
    "Modules": {
      "AssemblyPaths": [
        "C:/Work/redb_code/csharp/redb/redb.Tsak/src/redb.Tsak.Worker/modules"
      ]
    },
    "Contexts": {
      "default": {
        "AutoStart": true
      }
    },
    "Cluster": {
      // STANDALONE
      // "Enabled": false,

      // CLUSTER (active)
      "Enabled": true,
      "ClusterName": "default",
      "GroupName": "default",
      "NodeId": "",
      "ApiEndpoint": "http://localhost:9090",
      "HeartbeatIntervalSeconds": 15,
      "DeadNodeTimeoutSeconds": 60,
      "LeaderLockTtlSeconds": 30,
      "Strategy": "round-robin"
    },
    "HotReload": {
      "Enabled": true,
      "ScanIntervalSeconds": 10,
      "KeepVersions": 2,
      "StartupTimeoutSeconds": 60,
      "RollingUpdate": true,
      "Collectible": false
    },
    "Metrics": {
      "CollectionIntervalSeconds": 10,
      "HistoryHours": 12,
      "ClusterReportIntervalSeconds": 60,
      "Prometheus": {
        // Metrics are scraped from the Tsak facade: http://<host>:<Api.Port>/metrics
        // (auth-exempt). The OTel listener binds loopback :Port internally — no admin, no URL
        // ACL, no extra externally-exposed port on any OS. Just set Enabled (+ optional Port).
        "Enabled": true,
        "Port": 9464,
        "AdditionalMeters": [],
        "AdditionalSources": []
      }
    },
    "Tracing": {
      "ServiceName": "redb-tsak-worker",
      "Otlp": {
        // OpenTelemetry trace export. OFF by default. When Enabled=true, route/step spans
        // (and any AdditionalSources above) ship to the OTLP Endpoint — point it at a
        // collector or directly at Jaeger (native OTLP: gRPC :4317, http/protobuf :4318).
        "Enabled": true,
        "Endpoint": "http://localhost:4317",
        "Protocol": "grpc"
      }
    },
    "Api": {
      "Enabled": true,
      "Host": "0.0.0.0",
      "Port": 9090,
      "Echo": {
        // Auth-exempt route 'system-echo' on the main API port that reflects the request back
        // as JSON (liveness/debug probe). Its concrete path out-ranks the catch-all dispatcher
        // (specificity ordering), so no separate port is needed. Ships with AutoStart=false —
        // start it from the Routes API / dashboard when you need it.
        "Path": "/api/echo"
      }
    },
    "Logs": {
      "BufferSize": 2000
    },
    "Watchdog": {
      "Enabled": true,
      "CheckIntervalSeconds": 10,
      "SuspectedThresholdMinutes": 0.5,
      "HungThresholdMinutes": 1.5,
      "AutoRestartHungRoutes": false
    },
    "Auth": {
      "Enabled": true,
      "Secret": "<DEV_SECRET_PLACEHOLDER>",
      "Keys": [
        {
          "Id": "svc-web-dashboard",
          "KeyHash": "AD595EC6C321E437453D29496F9024759765AC9B7D720DB853DF82960E958F72",
          "Name": "web-dashboard",
          "Roles": "admin",
          "UserId": null
        }
      ]
    }
  },
  "Quartz": {
    "quartz.threadPool.type": "Quartz.Simpl.SimpleThreadPool, Quartz",
    "quartz.threadPool.threadCount": "10",
    "quartz.jobStore.type": "Quartz.Impl.AdoJobStore.JobStoreTX, Quartz",
    "quartz.jobStore.clustered": "false",
    "quartz.scheduler.instanceId": "AUTO",
    "quartz.scheduler.instanceName": "TsakScheduler"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Information",
        "System.Net.Http": "Warning",
        "Quartz": "Information",
        "redb.Tsak": "Information",
        "redb.Route": "Information",
        "redb.Identity": "Information",
        "OpenIddict": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [Mem: {MemoryUsage:N0} KB] {Message:lj} {NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [Mem: {MemoryUsage:N0} KB] {Message:lj} {NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithEnvironmentName",
      "WithProcessId",
      "WithProcessName",
      "WithThreadName"
    ]
  }
}

