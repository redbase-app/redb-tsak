{
  "ConnectionStrings": {
//#if (UsePostgres)
    "Postgres": "Host=localhost;Port=5432;Username=postgres;Password=postgres;Database=tsak;Pooling=true",
//#endif
//#if (UseMsSql)
    "MSSql": "Server=localhost;Database=tsak;User Id=sa;Password=Pass@word1;TrustServerCertificate=true",
//#endif
//#if (UseSqlite)
    "Sqlite": "Data Source=tsak.db"
//#endif
  },
  "Tsak": {
    "Storage": {
//#if (UseRedbStorage)
      "Type": "Redb"
//#else
      "Type": "InMemory"
//#endif
    },
    "Redb": {
//#if (UsePostgres)
      "Provider": "postgres",
//#endif
//#if (UseMsSql)
      "Provider": "mssql",
//#endif
//#if (UseSqlite)
      "Provider": "sqlite",
//#endif
      // The Pro redb tier is free in the 4.x line, and it is what the worker image runs on. Only the Free
      // tier needs DeleteInsert: batch ChangeTracking is not implemented there, so a module that saves
      // inside Transacted() - the usual pattern - fails on the first object.
//#if (pro)
      "UsePro": true,
      "License": [""],
      "PropsSaveStrategy": "ChangeTracking"
//#else
      "UsePro": false,
      "PropsSaveStrategy": "DeleteInsert"
//#endif
    },
    "Modules": {
      "AssemblyPaths": [ "Libs" ]
    },
    "Contexts": {
      "default": { "AutoStart": true }
    },
//#if (pro)
    "Cluster": {
      "Enabled": false,
      "ClusterName": "default",
      "GroupName": "default",
      "NodeId": "",
      "ApiEndpoint": "http://localhost:9090",
      "HeartbeatIntervalSeconds": 15,
      "DeadNodeTimeoutSeconds": 60,
      "LeaderLockTtlSeconds": 30,
      "Strategy": "round-robin"
    },
//#endif
    "HotReload": {
      "Enabled": true,
      "ScanIntervalSeconds": 10,
      "KeepVersions": 2,
      "StartupTimeoutSeconds": 60,
      // Not implemented by the runtime yet: nodes reload modules on their own scan schedule, so an
      // update is staged by deploying the package to the nodes one by one (the worker logs a warning).
      "RollingUpdate": false,
      "Collectible": false
    },
    "Metrics": {
      "CollectionIntervalSeconds": 10,
      "HistoryHours": 12,
      "Prometheus": {
        "_comment": "AdditionalMeters / AdditionalSources let modules hosted on top of Tsak expose their own OTel Meters / ActivitySources without taking a runtime dependency on Tsak. Example for redb.Identity: \"AdditionalMeters\": [\"RedbIdentity\"].",
        "Enabled": false,
        "Port": 9464
      }
    },
    "Api": {
      "Enabled": true,
      // Loopback by default: the management API has no authentication while Tsak:Auth:Enabled is false.
      // Bind 0.0.0.0 only behind your own gateway, or turn Auth on with a Secret first.
      "Host": "127.0.0.1",
      "Port": 9090
    },
    "Logs": {
      "BufferSize": 2000
    },
    "Watchdog": {
      "Enabled": true,
      "CheckIntervalSeconds": 10,
      "SuspectedThresholdMinutes": 0.5,
      "HungThresholdMinutes": 1.5,
      "AutoRestartHungRoutes": false
    },
    "Auth": {
      "Enabled": false,
      // Required - a long random value - as soon as Enabled is true; an empty secret leaves the
      // management API open to anyone who can reach the port.
      "Secret": "",
      "Keys": []
    }
  },
  "Quartz": {
    "quartz.threadPool.type": "Quartz.Simpl.SimpleThreadPool, Quartz",
    "quartz.threadPool.threadCount": "10",
//#if (UseRedbStorage)
    "quartz.jobStore.type": "Quartz.Impl.AdoJobStore.JobStoreTX, Quartz",
    "quartz.jobStore.clustered": "false",
//#else
    "quartz.jobStore.type": "Quartz.Simpl.RAMJobStore, Quartz",
//#endif
    "quartz.scheduler.instanceId": "AUTO",
    "quartz.scheduler.instanceName": "TsakScheduler"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Quartz": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/tsak-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  }
}
