<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>redb.Tsak.Templates</PackageId>
    <Title>redb.Tsak Project Templates</Title>
    <Authors>RedBase</Authors>
    <Company>RedBase</Company>
    <Description>Project templates for redb.Tsak — runtime container for redb.Route contexts. Use 'dotnet new tsak-worker' to create a ready-to-run host application with hot-reload module loading, REST management API, scheduler, monitoring and pluggable cluster bootstrap.</Description>
    <PackageTags>dotnet-new;templates;redbase;redb;tsak;worker;runtime;route;esb</PackageTags>
    <PackageProjectUrl>https://redbase.app</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/redbase-app/redb-tsak</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright (c) 2024-2026 RedBase</Copyright>

    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <TargetFramework>net9.0</TargetFramework>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="templates\**\*" Exclude="templates\**\bin\**;templates\**\obj\**" />
    <Compile Remove="**\*" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
